 "dialogues": {
  "bet": [
   {
    "npc": "Koshari again? You're so traditional.",
    "ar": "كشري تاني؟ إنت تقليدي أوي.",
    "options": [
     {
      "en": "Me? No way. I love international food!",
      "ok": true
     },
     {
      "en": "I am not tradition.",
      "why": "<b>tradition</b> اسم، والصفة <b>traditional</b>. والأحلى: <b>No way!</b>"
     },
     {
      "en": "Yes, I am koshari.",
      "why": "كده بتقول «أنا كشري» 😂"
     }
    ],
    "after": "Prove it.",
    "teaches": [
     "traditional",
     "international"
    ]
   },
   {
    "npc": "One dish from four parts of the world, tonight. Deal?",
    "ar": "أكلة من ٤ مناطق في العالم، النهارده. اتفقنا؟",
    "options": [
     {
      "en": "Let's make a bet. The loser pays for dinner.",
      "ok": true
     },
     {
      "en": "Okay, we bet money food.",
      "why": "الصح: <b>Let's make a bet.</b>"
     },
     {
      "en": "I make bet with you.",
      "why": "الطبيعي: <b>Let's make a bet.</b> أو <b>You're on!</b>"
     }
    ],
    "after": "Deal! Start with Asia. The chef over there is amazing."
   }
  ],
  "sushi": [
   {
    "npc": "Welcome! What would you like?",
    "ar": "أهلاً! تحب تاكل إيه؟",
    "options": [
     {
      "en": "I'll have the sushi, please.",
      "ok": true
     },
     {
      "en": "I want eat sushi.",
      "why": "ناقصها <b>to</b>، والأحسن: <b>I'll have the sushi, please.</b>"
     },
     {
      "en": "Give sushi.",
      "why": "أمر ناشف. قول: <b>I'll have…, please.</b>"
     }
    ],
    "after": "Great choice. Sushi is cold rice with fresh fish on top.",
    "teaches": [
     "sushi",
     "rice"
    ]
   },
   {
    "npc": "Do you want wasabi with it? It's very spicy.",
    "ar": "عايز وسابي معاه؟ حراق جداً.",
    "options": [
     {
      "en": "Just a little, please. I don't like it too spicy.",
      "ok": true
     },
     {
      "en": "I am spicy.",
      "why": "كده بتقول «أنا حراق» 😂 قول: <b>I don't like it too spicy.</b>"
     },
     {
      "en": "Wasabi is how much spicy?",
      "why": "الصح: <b>How spicy is it?</b>"
     }
    ],
    "after": "Just a little. Good idea!",
    "teaches": [
     "spicy"
    ]
   },
   {
    "npc": "Anything else? Some soy sauce?",
    "ar": "أي حاجة تانية؟ شوية صويا صوص؟",
    "options": [
     {
      "en": "Yes, please. That's all, thanks.",
      "ok": true
     },
     {
      "en": "Soy sauce is yes.",
      "why": "قول ببساطة: <b>Yes, please.</b>"
     },
     {
      "en": "No more, finish.",
      "why": "الطبيعي: <b>That's all, thanks.</b>"
     }
    ],
    "after": "Here you go. Enjoy!",
    "teaches": [
     "soy sauce"
    ]
   }
  ],
  "win": [
   {
    "npc": "So? Did you really eat from all four?",
